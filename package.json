{
  "name": "decentralized-identity-zk-access-control",
  "version": "1.0.0",
  "description": "Decentralized Identity System with Zero-Knowledge Proof Access Control",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test test/contracts/*.test.js",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network sepolia",
    "node": "hardhat node",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm run dev",
    "circuits:compile": "cd circuits && ./compile.sh",
    "circuits:setup": "cd circuits && ./setup.sh",
    "dev": "concurrently \"npm run node\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,sol,md}\"",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:sol": "solhint 'contracts/**/*.sol'"
  },
  "keywords": [
    "blockchain",
    "decentralized-identity",
    "zero-knowledge",
    "DID",
    "privacy",
    "access-control"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "circomlib": "^2.0.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.2.4",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "dotenv": "^16.4.1",
    "ethers": "^6.10.0",
    "snarkjs": "^0.7.3"
  }
}
